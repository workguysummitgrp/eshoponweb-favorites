@model CatalogItemViewModel

@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isFavorited = Model.IsFavorited;
    var heartModifier = !isAuthenticated ? " esh-favorite-heart--disabled"
                      : isFavorited     ? " esh-favorite-heart--favorited"
                      : "";
    var ariaPressed = isFavorited ? "true" : "false";
    var ariaLabel = isFavorited
        ? $"Remove {Model.Name} from favorites"
        : $"Add {Model.Name} to favorites";
}

<form asp-page="/Basket/Index" method="post">
    <div class="esh-catalog-thumbnail-wrapper">
        <img class="esh-catalog-thumbnail" src="@Model.PictureUri" />
        <button class="esh-favorite-heart@(heartModifier)"
                type="button"
                data-catalog-item-id="@Model.Id"
                data-authenticated="@isAuthenticated.ToString().ToLowerInvariant()"
                aria-label="@ariaLabel"
                aria-pressed="@ariaPressed"
                title="@(isFavorited ? "Remove from favorites" : "Add to favorites")">
            <svg class="esh-favorite-heart__icon"
                 viewBox="0 0 24 24"
                 xmlns="http://www.w3.org/2000/svg"
                 aria-hidden="true"
                 focusable="false">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5
                         2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09
                         C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5
                         c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
        </button>
    </div>
    <input class="esh-catalog-button" type="submit" value="[ ADD TO BASKET ]" />
    <div class="esh-catalog-name">
        <span>@Model.Name</span>
    </div>
    <div class="esh-catalog-price">
        <span>@Model.Price.ToString("N2")</span>
    </div>
    <input type="hidden" asp-for="@Model.Id" name="id" />
    <input type="hidden" asp-for="@Model.Name" name="name" />
    <input type="hidden" asp-for="@Model.PictureUri" name="pictureUri" />
    <input type="hidden" asp-for="@Model.Price" name="price" />
</form>
